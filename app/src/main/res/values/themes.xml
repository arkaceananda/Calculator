<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Calculator" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/black</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background splash screen -->
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <!-- Ikon di tengah (gunakan logo Anda) -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/logo</item>
        <!-- Durasi splash screen (hanya berlaku di Android 12+) -->
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <!-- Tema yang akan digunakan setelah splash selesai -->
        <item name="postSplashScreenTheme">@style/Theme.Calculator</item>
    </style>
</resources>